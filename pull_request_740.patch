diff --git a/enn_torch_dev/debug/executor/test_store_overlay.py b/enn_torch_dev/debug/executor/test_store_overlay.py
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/enn_torch_dev/debug/executor/test_store_overlay.py
--- /dev/null+++ b/enn_torch_dev/debug/executor/test_store_overlay.py@@ -0,0 +1,151 @@+from __future__ import annotations
+
+import pytest
+import torch
+
+from enn_torch_dev.executor import GraphValue, KVStore, KeyRef
+
+
+def test_fork_reads_parent_keys() -> None:
+    x = torch.randn(2, 3)
+    base = KVStore({"x": x})
+    child = base.fork()
+
+    assert child.parent is base
+    assert child.has("x")
+    assert "x" in child
+    assert torch.equal(child.get("x"), x)
+    assert torch.equal(child.resolve(KeyRef("x")), x)
+
+
+def test_fork_set_writes_local_only() -> None:
+    base = KVStore({"x": torch.ones(2, 3)})
+    child = base.fork()
+
+    child.set("y", torch.full((2, 3), 2.0))
+
+    assert child.has("y")
+    assert not base.has("y")
+    assert child.local_keys() == ("y",)
+
+
+def test_local_key_overrides_parent_key() -> None:
+    base = KVStore({"x": torch.ones(2, 3)})
+    child = base.fork()
+
+    child.set("x", torch.full((2, 3), 3.0))
+
+    assert torch.allclose(base.get("x"), torch.ones(2, 3))
+    assert torch.allclose(child.get("x"), torch.full((2, 3), 3.0))
+    assert child.local_keys() == ("x",)
+
+
+def test_keys_include_parent() -> None:
+    base = KVStore({"x": torch.ones(1), "shared": torch.tensor([1.0])})
+    child = base.fork({"y": torch.full((1,), 2.0)})
+    child.set("shared", torch.tensor([3.0]))
+
+    assert child.keys() == ("y", "shared")
+    assert child.keys(include_parent=True) == ("x", "shared", "y")
+
+
+def test_get_value_falls_back_to_parent_metadata() -> None:
+    base = KVStore()
+    base.set("x", torch.ones(1), layout="B", origin="base")
+    child = base.fork()
+
+    value = child.get_value("x")
+
+    assert isinstance(value, GraphValue)
+    assert value.layout == "B"
+    assert value.origin == "base"
+
+
+def test_commit_to_copies_local_keys_to_target() -> None:
+    base = KVStore({"x": torch.ones(1)})
+    child = base.fork()
+    target = KVStore()
+
+    child.set("y", torch.full((1,), 2.0))
+    child.commit_to(target)
+
+    assert not target.has("x")
+    assert torch.equal(target.get("y"), torch.full((1,), 2.0))
+
+
+def test_commit_to_selected_keys_only() -> None:
+    child = KVStore()
+    target = KVStore()
+
+    child.set("a", torch.tensor([1.0]))
+    child.set("b", torch.tensor([2.0]))
+    child.commit_to(target, keys=["b"])
+
+    assert not target.has("a")
+    assert torch.equal(target.get("b"), torch.tensor([2.0]))
+
+
+def test_commit_to_rejects_parent_only_key() -> None:
+    base = KVStore({"x": torch.ones(1)})
+    child = base.fork()
+    target = KVStore()
+
+    with pytest.raises(KeyError, match="local key"):
+        child.commit_to(target, keys=["x"])
+
+
+def test_commit_to_overwrite_false_preserves_target_value() -> None:
+    source = KVStore({"x": torch.tensor([1.0])})
+    target = KVStore({"x": torch.tensor([9.0])})
+
+    source.commit_to(target, overwrite=False)
+
+    assert torch.equal(target.get("x"), torch.tensor([9.0]))
+
+
+def test_commit_to_rejects_string_keys_argument() -> None:
+    source = KVStore({"x": torch.tensor([1.0])})
+    target = KVStore()
+
+    with pytest.raises(TypeError, match="sequence"):
+        source.commit_to(target, keys="x")
+
+
+def test_delete_removes_local_key_only() -> None:
+    base = KVStore({"x": torch.ones(1)})
+    child = base.fork()
+
+    child.set("x", torch.full((1,), 2.0))
+    child.delete("x")
+
+    assert torch.equal(child.get("x"), torch.ones(1))
+    assert torch.equal(base.get("x"), torch.ones(1))
+
+
+def test_delete_parent_only_key_raises_unless_missing_ok() -> None:
+    base = KVStore({"x": torch.ones(1)})
+    child = base.fork()
+
+    with pytest.raises(KeyError, match="local key"):
+        child.delete("x")
+
+    child.delete("x", missing_ok=True)
+    assert child.has("x")
+
+
+def test_optional_missing_key_uses_default_through_overlay() -> None:
+    base = KVStore()
+    child = base.fork()
+
+    assert child.get("missing", optional=True, default=123) == 123
+
+
+def test_shallow_copy_preserves_parent() -> None:
+    base = KVStore({"x": torch.ones(1)})
+    child = base.fork({"y": torch.full((1,), 2.0)})
+
+    copied = child.shallow_copy()
+
+    assert copied.parent is base
+    assert torch.equal(copied.get("x"), torch.ones(1))
+    assert torch.equal(copied.get("y"), torch.full((1,), 2.0))
