+    model = (
+        ModelBuilder()
+        .add(
+            name="local",
+            module=_Double(),
+            input_args=["tile.x"],
+            output_key="local.out",
+        )
+        .build_tile(
+            tile_shape=(2,),
+            input_key="x",
+            tile_input_key="tile.x",
+            output_name="local",
