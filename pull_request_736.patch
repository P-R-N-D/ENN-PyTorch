+    def _input_refs_for_node(self, name: str) -> tuple[KeyRef, ...]:
+        node = self._nodes[name]
+        refs: list[KeyRef] = []
+
+        if isinstance(node, NodeExecutor):
+            refs.extend(node.spec.input_args)
+            refs.extend(node.spec.input_kwargs.values())
