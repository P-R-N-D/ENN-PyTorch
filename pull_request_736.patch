diff --git a/enn_torch_dev/debug/executor/test_execution_order.py b/enn_torch_dev/debug/executor/test_execution_order.py
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/enn_torch_dev/debug/executor/test_execution_order.py
--- /dev/null+++ b/enn_torch_dev/debug/executor/test_execution_order.py@@ -0,0 +1,178 @@+from __future__ import annotations
+
+import pytest
+import torch
+from torch import nn
+
+from enn_torch_dev.executor import GraphExecutor, KVStore, KeyRef, NodeSpec, SubgraphSpec
+from enn_torch_dev.nn import Reducer
+
+
+class _AddOne(nn.Module):
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return x + 1.0
+
+
+class _TimesTwo(nn.Module):
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return x * 2.0
+
+
+def test_graph_executor_execution_order_uses_output_key_dependencies() -> None:
+    graph = GraphExecutor()
+    graph.add_node(
+        NodeSpec(
+            name="consumer",
+            input_args=[KeyRef("producer.out")],
+            output_key="consumer.out",
+        ),
+        _TimesTwo(),
+    )
+    graph.add_node(
+        NodeSpec(
+            name="producer",
+            input_args=[KeyRef("x")],
+            output_key="producer.out",
+        ),
+        _AddOne(),
+    )
+
+    assert graph.node_names() == ("consumer", "producer")
+    assert graph.execution_order() == ("producer", "consumer")
+
+    store = KVStore({"x": torch.ones(2, 3)})
+    graph.run(store)
+
+    assert torch.allclose(store.get("consumer.out"), torch.full((2, 3), 4.0))
+
+
+def test_graph_executor_execution_order_keeps_external_inputs_free() -> None:
+    graph = GraphExecutor()
+    graph.add_node(
+        NodeSpec(name="a", input_args=[KeyRef("external.x")], output_key="a.out"),
+        nn.Identity(),
+    )
+
+    assert graph.execution_order() == ("a",)
+
+
+def test_graph_executor_execution_order_runs_subgraph_after_children() -> None:
+    graph = GraphExecutor()
+    graph.add_node(
+        NodeSpec(name="a", input_args=[KeyRef("x")], output_key="a.out"),
+        _AddOne(),
+    )
+    graph.add_node(
+        NodeSpec(name="b", input_args=[KeyRef("x")], output_key="b.out"),
+        _TimesTwo(),
+    )
+    graph.add_subgraph(
+        SubgraphSpec(name="merge", children=["a", "b"], output_key="merge.out"),
+        Reducer(op="mean"),
+    )
+
+    assert graph.execution_order() == ("a", "b", "merge")
+
+    store = KVStore({"x": torch.ones(2, 3)})
+    graph.run(store)
+
+    assert torch.allclose(store.get("merge.out"), torch.full((2, 3), 2.0))
+
+
+def test_graph_executor_execution_order_handles_two_level_subgraphs() -> None:
+    graph = GraphExecutor()
+    graph.add_node(
+        NodeSpec(name="a", input_args=[KeyRef("x")], output_key="a.out"),
+        _AddOne(),
+    )
+    graph.add_node(
+        NodeSpec(name="b", input_args=[KeyRef("x")], output_key="b.out"),
+        _TimesTwo(),
+    )
+    graph.add_subgraph(
+        SubgraphSpec(name="ab", children=["a", "b"], output_key="ab.out"),
+        Reducer(op="mean"),
+    )
+    graph.add_node(
+        NodeSpec(name="c", input_args=[KeyRef("x")], output_key="c.out"),
+        nn.Identity(),
+    )
+    graph.add_subgraph(
+        SubgraphSpec(name="root", children=["ab", "c"], output_key="root.out"),
+        Reducer(op="mean"),
+    )
+
+    assert graph.execution_order() == ("a", "b", "ab", "c", "root")
+
+
+def test_graph_executor_rejects_duplicate_output_key() -> None:
+    graph = GraphExecutor()
+    graph.add_node(NodeSpec(name="a", output_key="shared.out"), nn.Identity())
+
+    with pytest.raises(ValueError, match="Duplicate output_key"):
+        graph.add_node(NodeSpec(name="b", output_key="shared.out"), nn.Identity())
+
+    with pytest.raises(ValueError, match="Duplicate output_key"):
+        graph.add_subgraph(
+            SubgraphSpec(name="merge", children=["a"], output_key="shared.out"),
+            Reducer(op="mean"),
+        )
+
+
+def test_graph_executor_detects_cycle_from_output_key_dependencies() -> None:
+    graph = GraphExecutor()
+    graph.add_node(
+        NodeSpec(name="a", input_args=[KeyRef("b.out")], output_key="a.out"),
+        nn.Identity(),
+    )
+    graph.add_node(
+        NodeSpec(name="b", input_args=[KeyRef("a.out")], output_key="b.out"),
+        nn.Identity(),
+    )
+
+    with pytest.raises(RuntimeError, match="Cycle detected"):
+        graph.execution_order()
+
+
+def test_graph_executor_remove_node_rejects_dataflow_dependent() -> None:
+    graph = GraphExecutor()
+    graph.add_node(NodeSpec(name="a", output_key="a.out"), nn.Identity())
+    graph.add_node(
+        NodeSpec(name="b", input_args=[KeyRef("a.out")], output_key="b.out"),
+        nn.Identity(),
+    )
+
+    with pytest.raises(ValueError, match="dependent nodes"):
+        graph.remove_node("a")
+
+
+def test_graph_executor_remove_subtree_rejects_external_dataflow_dependency() -> None:
+    graph = GraphExecutor()
+    graph.add_node(NodeSpec(name="a", output_key="a.out"), nn.Identity())
+    graph.add_node(
+        NodeSpec(name="b", input_args=[KeyRef("a.out")], output_key="b.out"),
+        nn.Identity(),
+    )
+
+    with pytest.raises(ValueError, match="external parent/dependent"):
+        graph.remove_subtree("a")
+
+
+def test_graph_executor_remove_node_cleans_output_producer_index() -> None:
+    graph = GraphExecutor()
+    graph.add_node(NodeSpec(name="a", output_key="a.out"), nn.Identity())
+
+    graph.remove_node("a")
+
+    graph.add_node(NodeSpec(name="b", output_key="a.out"), nn.Identity())
+    assert graph.execution_order() == ("b",)
+
+
+def test_graph_executor_remove_subtree_cleans_output_producer_index() -> None:
+    graph = GraphExecutor()
+    graph.add_node(NodeSpec(name="a", output_key="a.out"), nn.Identity())
+
+    graph.remove_subtree("a")
+
+    graph.add_node(NodeSpec(name="b", output_key="a.out"), nn.Identity())
+    assert graph.execution_order() == ("b",)
