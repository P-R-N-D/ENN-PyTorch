+from __future__ import annotations
+
+import pytest
+import torch
+
+from enn_torch_dev.nn.blocks import Composer, ContextSummary
+
+
+def test_composer_forward_returns_context_summary():
+    x = torch.randn(2, 3, 4, 5)
+    composer = Composer(5)
+
+    summary = composer(x)
+
+    assert isinstance(summary, ContextSummary)
+    assert summary.tokens.shape == (2, 12, 5)
+    assert summary.token_mask is None
+    assert summary.attn_bias is None
+    assert summary.original_shape == (2, 3, 4, 5)
+
+
+def test_composer_masks_tokens_to_zero():
+    x = torch.randn(2, 3, 4, 5)
+    mask = torch.ones(2, 3, 4, dtype=torch.bool)
+    mask[0, 1, 2] = False
+    composer = Composer(5)
+
+    summary = composer(x, context_mask=mask)
+
+    flat_idx = 1 * 4 + 2
+    assert torch.allclose(summary.tokens[0, flat_idx], torch.zeros_like(summary.tokens[0, flat_idx]))
+    assert summary.token_mask is not None
+    assert not summary.token_mask[0, flat_idx]
+
+
+def test_composer_forward_compat_returns_tensors_without_none():
+    x = torch.randn(2, 3, 4, 5)
+    composer = Composer(5)
+
+    tokens, token_mask, attn_bias = composer.forward_compat(x)
+
+    assert tokens.shape == (2, 12, 5)
+    assert token_mask.shape == (2, 12)
+    assert token_mask.dtype == torch.bool
+    assert token_mask.all()
+    assert attn_bias.shape == (2, 1, 1, 12)
+    assert torch.allclose(attn_bias, torch.zeros_like(attn_bias))
+
+
+@pytest.mark.parametrize("mode", ["score", "soft_topk"])
+def test_composer_salience_modes_are_finite(mode):
+    x = torch.randn(2, 3, 4, 5)
+    mask = torch.rand(2, 3, 4) > 0.2
+    composer = Composer(5, salience_mode=mode, salience_topk=3)
+
+    summary = composer(x, context_mask=mask)
+
+    assert summary.score is not None
+    assert summary.salience is not None
+    assert summary.attn_bias is not None
+    assert torch.isfinite(summary.salience).all()
+    assert torch.isfinite(summary.attn_bias[summary.token_mask[:, None, None, :]]).all()
+
+
+def test_composer_rejects_negative_salience_bias_scale():
+    with pytest.raises(ValueError, match="non-negative"):
+        Composer(5, salience_bias_scale=-1.0)
+
+
+@pytest.mark.parametrize("dtype", [torch.int64, torch.bool, torch.complex64])
+def test_composer_accepts_common_input_dtypes(dtype):
+    if dtype == torch.complex64:
+        x = torch.randn(2, 3, 4, 5, dtype=torch.complex64)
+    elif dtype == torch.bool:
+        x = torch.randint(0, 2, (2, 3, 4, 5), dtype=torch.bool)
+    else:
+        x = torch.randint(0, 10, (2, 3, 4, 5), dtype=torch.int64)
+
+    composer = Composer(5)
+    summary = composer(x)
+
+    assert summary.tokens.is_floating_point()
+    assert summary.tokens.dtype == torch.float32
+
+
+def test_composer_restore_masks_invalid_slots():
+    x = torch.randn(2, 3, 4, 5)
+    mask = torch.ones(2, 3, 4, dtype=torch.bool)
+    mask[0, 1, 2] = False
+    composer = Composer(5)
+    summary = composer(x, context_mask=mask)
+
+    restored = composer.restore(summary.tokens, summary)
+
+    assert restored.shape == x.shape
+    assert torch.allclose(restored[0, 1, 2], torch.zeros_like(restored[0, 1, 2]))