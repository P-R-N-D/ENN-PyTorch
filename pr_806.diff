index 0000000..5134120
--- /dev/null
+++ b/enn_torch_dev/debug/runtime/test_runtime_governor.py
@@ -0,0 +1,283 @@
+from __future__ import annotations
+
+import math
+
+import pytest
+import torch
+
+from enn_torch_dev.runtime import (
+    BatchBudget,
+    ConservativeRuntimeGovernor,
+    GovernorPolicy,
+    ResourceSample,
+    RuntimeGovernorState,
+    StepResult,
+    StepStatus,
+)
+
+
+def _result(
+    status: StepStatus,
+    *,
+    samples: tuple[ResourceSample, ...] = (),
+) -> StepResult:
+    return StepResult(
+        status=status,
+        phase=None,
+        batch_size=2,
+        row_ids=torch.arange(2),
+        resource_samples=samples,
+    )
+
+
+def test_governor_keeps_budget_without_results() -> None:
+    budget = BatchBudget(max_items=8)
+    governor = ConservativeRuntimeGovernor(budget)
+
+    decision = governor.observe_results([])
+
+    assert decision.previous_budget == budget
+    assert decision.next_budget == budget
+    assert governor.current_budget == budget
+    assert decision.statuses == ()
+    assert decision.reason.startswith("no_results")
+
+
+def test_governor_keeps_budget_before_success_growth_threshold() -> None:
+    budget = BatchBudget(max_items=8)
+    governor = ConservativeRuntimeGovernor(
+        budget,
+        policy=GovernorPolicy(grow_after_successes=2, grow_factor=1.5),
+    )
+
+    decision = governor.observe_results([_result(StepStatus.SUCCESS)])
+
+    assert decision.next_budget.max_items == 8
+    assert decision.consecutive_successes == 1
+    assert governor.current_budget.max_items == 8
+
+
+def test_governor_success_streak_advances_once_per_observation() -> None:
+    governor = ConservativeRuntimeGovernor(
+        BatchBudget(max_items=8),
+        policy=GovernorPolicy(grow_after_successes=2, grow_factor=1.5),
+    )
+
+    decision = governor.observe_results(
+        [_result(StepStatus.SUCCESS), _result(StepStatus.SUCCESS)]
+    )
+
+    assert decision.next_budget.max_items == 8
+    assert decision.consecutive_successes == 1
+    assert "success_streak:1/2" in decision.reason
+
+
+def test_governor_grows_budget_after_success_streak_and_resets_streak() -> None:
+    governor = ConservativeRuntimeGovernor(
+        BatchBudget(max_items=8),
+        policy=GovernorPolicy(grow_after_successes=2, grow_factor=1.5, max_items=16),
+    )
+
+    first = governor.observe_results([_result(StepStatus.SUCCESS)])
+    second = governor.observe_results([_result(StepStatus.SUCCESS)])
+
+    assert first.next_budget.max_items == 8
+    assert second.previous_budget.max_items == 8
+    assert second.next_budget.max_items == 12
+    assert governor.current_budget.max_items == 12
+    assert governor.state.consecutive_successes == 0
+    assert "success_streak:2" in second.reason
+
+
+def test_governor_shrinks_all_configured_budget_fields_on_oom() -> None:
+    governor = ConservativeRuntimeGovernor(
+        BatchBudget(max_items=9, max_host_bytes=101, max_device_bytes=201),
+        policy=GovernorPolicy(shrink_factor=0.5, min_items=2),
+    )
+
+    decision = governor.observe_results([_result(StepStatus.OOM_FAULT)])
+
+    assert decision.next_budget.max_items == 4
+    assert decision.next_budget.max_host_bytes == 50
+    assert decision.next_budget.max_device_bytes == 100
+    assert decision.consecutive_successes == 0
+    assert decision.consecutive_ooms == 1
+    assert governor.current_budget == decision.next_budget
+    assert decision.reason.startswith("oom_fault")
+
+
+def test_governor_does_not_activate_unconfigured_budget_fields() -> None:
+    governor = ConservativeRuntimeGovernor(
+        BatchBudget(max_items=8),
+        policy=GovernorPolicy(
+            shrink_factor=0.5,
+            grow_factor=2.0,
+            grow_after_successes=1,
+            min_host_bytes=4,
+            max_host_bytes=128,
+            min_device_bytes=4,
+            max_device_bytes=256,
+        ),
+    )
+
+    oom = governor.observe_results([_result(StepStatus.OOM_FAULT)])
+    success = governor.observe_results([_result(StepStatus.SUCCESS)])
+
+    assert oom.next_budget.max_items == 4
+    assert oom.next_budget.max_host_bytes is None
+    assert oom.next_budget.max_device_bytes is None
+    assert success.next_budget.max_items == 8
+    assert success.next_budget.max_host_bytes is None
+    assert success.next_budget.max_device_bytes is None
+
+
+def test_governor_respects_bounds() -> None:
+    governor = ConservativeRuntimeGovernor(
+        BatchBudget(max_items=2, max_host_bytes=4, max_device_bytes=4),
+        policy=GovernorPolicy(
+            shrink_factor=0.5,
+            grow_factor=4.0,
+            grow_after_successes=1,
+            min_items=2,
+            max_items=8,
+            min_host_bytes=3,
+            max_host_bytes=6,
+            min_device_bytes=3,
+            max_device_bytes=6,
+        ),
+    )
+
+    oom = governor.observe_results([_result(StepStatus.OOM_FAULT)])
+    success = governor.observe_results([_result(StepStatus.SUCCESS)])
+
+    assert oom.next_budget.max_items == 2
+    assert oom.next_budget.max_host_bytes == 3
+    assert oom.next_budget.max_device_bytes == 3
+    assert success.next_budget.max_items == 8
+    assert success.next_budget.max_host_bytes == 6
+    assert success.next_budget.max_device_bytes == 6
+
+
+def test_governor_prioritizes_oom_in_mixed_results() -> None:
+    governor = ConservativeRuntimeGovernor(BatchBudget(max_items=8))
+    governor.observe_results([_result(StepStatus.SUCCESS)])
+
+    decision = governor.observe_results(
+        [
+            _result(StepStatus.SUCCESS),
+            _result(StepStatus.DATA_FAULT),
+            _result(StepStatus.OOM_FAULT),
+        ]
+    )
+
+    assert decision.next_budget.max_items == 4
+    assert decision.consecutive_successes == 0
+    assert decision.consecutive_ooms == 1
+    assert decision.reason.startswith("oom_fault")
+
+
+def test_governor_keeps_budget_for_non_oom_faults() -> None:
+    governor = ConservativeRuntimeGovernor(BatchBudget(max_items=8))
+    governor.observe_results([_result(StepStatus.SUCCESS)])
+
+    decision = governor.observe_results([_result(StepStatus.DATA_FAULT)])
+
+    assert decision.next_budget.max_items == 8
+    assert decision.consecutive_successes == 0
+    assert decision.consecutive_ooms == 0
+    assert decision.reason.startswith("non_oom_fault")
+
+
+def test_governor_records_resource_peaks_in_decision_and_reason() -> None:
+    sample = ResourceSample(
+        timestamp_ns=10,
+        phase="after_forward",
+        cpu_rss_bytes=123,
+        cuda_available=True,
+        cuda_allocated_bytes=234,
+        cuda_reserved_bytes=345,
+        cuda_max_allocated_bytes=456,
+        cuda_max_reserved_bytes=789,
+    )
+    governor = ConservativeRuntimeGovernor(BatchBudget(max_items=8))
+
+    decision = governor.observe_results([_result(StepStatus.SUCCESS, samples=(sample,))])
+
+    assert decision.peak_cpu_rss_bytes == 123
+    assert decision.peak_cuda_allocated_bytes == 234
+    assert decision.peak_cuda_reserved_bytes == 345
+    assert decision.peak_cuda_max_allocated_bytes == 456
+    assert decision.peak_cuda_max_reserved_bytes == 789
+    assert "peak_cpu_rss_bytes=123" in decision.reason
+    assert "peak_cuda_allocated_bytes=234" in decision.reason
+    assert "peak_cuda_reserved_bytes=345" in decision.reason
+    assert "peak_cuda_max_allocated_bytes=456" in decision.reason
+    assert "peak_cuda_max_reserved_bytes=789" in decision.reason
+
+
+def test_governor_rejects_invalid_policy_values() -> None:
+    with pytest.raises(ValueError, match="shrink_factor"):
+        GovernorPolicy(shrink_factor=1.0)
+    with pytest.raises(ValueError, match="shrink_factor"):
+        GovernorPolicy(shrink_factor=math.nan)
+    with pytest.raises(ValueError, match="grow_factor"):
+        GovernorPolicy(grow_factor=1.0)
+    with pytest.raises(ValueError, match="grow_after_successes"):
+        GovernorPolicy(grow_after_successes=0)
+    with pytest.raises(ValueError, match="min_items"):
+        GovernorPolicy(min_items=0)
+    with pytest.raises(ValueError, match="max_items"):
+        GovernorPolicy(max_items=0)
+    with pytest.raises(ValueError, match="min_host_bytes"):
+        GovernorPolicy(min_host_bytes=0)
+    with pytest.raises(ValueError, match="items"):
+        GovernorPolicy(min_items=8, max_items=4)
+    with pytest.raises(ValueError, match="host_bytes"):
+        GovernorPolicy(min_host_bytes=8, max_host_bytes=4)
+    with pytest.raises(TypeError, match="max_device_bytes"):
+        GovernorPolicy(max_device_bytes="large")  # type: ignore[arg-type]
+
+
+def test_governor_rejects_invalid_arguments() -> None:
+    with pytest.raises(ValueError, match="budget or state"):
+        ConservativeRuntimeGovernor()
+    with pytest.raises(TypeError, match="budget"):
+        ConservativeRuntimeGovernor(object())  # type: ignore[arg-type]
+    with pytest.raises(ValueError, match="configured budget fields"):
+        ConservativeRuntimeGovernor(BatchBudget(max_items=0))
+    with pytest.raises(TypeError, match="policy"):
+        ConservativeRuntimeGovernor(BatchBudget(max_items=1), policy=object())  # type: ignore[arg-type]
+    with pytest.raises(TypeError, match="state"):
+        ConservativeRuntimeGovernor(BatchBudget(max_items=1), state=object())  # type: ignore[arg-type]
+    with pytest.raises(ValueError, match="budget or state"):
+        ConservativeRuntimeGovernor(
+            BatchBudget(max_items=1),
+            state=RuntimeGovernorState(current_budget=BatchBudget(max_items=1)),
+        )
+
+    governor = ConservativeRuntimeGovernor(BatchBudget(max_items=1))
+    with pytest.raises(TypeError, match="iterable"):
+        governor.observe_results(_result(StepStatus.SUCCESS))  # type: ignore[arg-type]
+    with pytest.raises(TypeError, match="StepResult"):
+        governor.observe_results([object()])  # type: ignore[list-item]
+
+
+def test_governor_reuses_explicit_immutable_state_by_replacing_it() -> None:
+    state = RuntimeGovernorState(
+        current_budget=BatchBudget(max_items=4),
+        consecutive_successes=1,
+    )
+    governor = ConservativeRuntimeGovernor(
+        policy=GovernorPolicy(grow_after_successes=2, grow_factor=2.0),
+        state=state,
+    )
+
+    decision = governor.observe_results([_result(StepStatus.SUCCESS)])
+
+    assert decision.next_budget.max_items == 8
+    assert state.consecutive_successes == 1
+    assert state.last_decision is None
+    assert governor.state is not state
+    assert governor.state.last_decision is decision
+    assert governor.state.current_budget.max_items == 8
+    assert governor.state.consecutive_successes == 0
