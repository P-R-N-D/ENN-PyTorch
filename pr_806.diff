--- /dev/null
+++ b/enn_torch_dev/runtime/governor.py
@@ -0,0 +1,387 @@
+from __future__ import annotations
+
+import math
+from collections.abc import Iterable
+from dataclasses import dataclass, replace
+
+from .batching import BatchBudget
+from .faults import ResourceSample, StepResult, StepStatus
+
+
+def _validate_optional_positive_limit(value: object, label: str) -> int | None:
+    if value is None:
+        return None
+    if not isinstance(value, int) or isinstance(value, bool):
+        raise TypeError(f"{label} must be an integer or None.")
+    if value <= 0:
+        raise ValueError(f"{label} must be positive.")
+    return value
+
+
+def _validate_factor(value: object, label: str, *, shrink: bool) -> float:
+    if not isinstance(value, (int, float)) or isinstance(value, bool):
+        raise TypeError(f"{label} must be a number.")
+    factor = float(value)
+    if not math.isfinite(factor):
+        raise ValueError(f"{label} must be finite.")
+    if shrink:
+        if not 0.0 < factor < 1.0:
+            raise ValueError(f"{label} must be greater than 0 and less than 1.")
+    elif factor <= 1.0:
+        raise ValueError(f"{label} must be greater than 1.")
+    return factor
+
+
+def _check_bounds(lower: int | None, upper: int | None, label: str) -> None:
+    if lower is not None and upper is not None and lower > upper:
+        raise ValueError(f"{label} minimum must be less than or equal to maximum.")
+
+
+def _validate_governed_budget(budget: BatchBudget, label: str) -> None:
+    configured = (
+        budget.max_host_bytes,
+        budget.max_device_bytes,
+        budget.max_items,
+    )
+    if all(value is None for value in configured):
+        raise ValueError(f"{label} must define at least one configured budget field.")
+    if any(value is not None and value <= 0 for value in configured):
+        raise ValueError(f"{label} configured budget fields must be positive.")
+
+
+@dataclass(frozen=True, slots=True)
+class GovernorPolicy:
+    """Conservative bounds and scaling rules for runtime budget decisions."""
+
+    shrink_factor: float = 0.5
+    grow_factor: float = 1.25
+    grow_after_successes: int = 3
+    min_items: int | None = 1
+    max_items: int | None = None
+    min_host_bytes: int | None = None
+    max_host_bytes: int | None = None
+    min_device_bytes: int | None = None
+    max_device_bytes: int | None = None
+
+    def __post_init__(self) -> None:
+        object.__setattr__(
+            self,
+            "shrink_factor",
+            _validate_factor(self.shrink_factor, "GovernorPolicy.shrink_factor", shrink=True),
+        )
+        object.__setattr__(
+            self,
+            "grow_factor",
+            _validate_factor(self.grow_factor, "GovernorPolicy.grow_factor", shrink=False),
+        )
+        if not isinstance(self.grow_after_successes, int) or isinstance(
+            self.grow_after_successes,
+            bool,
+        ):
+            raise TypeError("GovernorPolicy.grow_after_successes must be an integer.")
+        if self.grow_after_successes <= 0:
+            raise ValueError("GovernorPolicy.grow_after_successes must be positive.")
+        object.__setattr__(
+            self,
+            "min_items",
+            _validate_optional_positive_limit(self.min_items, "GovernorPolicy.min_items"),
+        )
+        object.__setattr__(
+            self,
+            "max_items",
+            _validate_optional_positive_limit(self.max_items, "GovernorPolicy.max_items"),
+        )
+        object.__setattr__(
+            self,
+            "min_host_bytes",
+            _validate_optional_positive_limit(
+                self.min_host_bytes,
+                "GovernorPolicy.min_host_bytes",
+            ),
+        )
+        object.__setattr__(
+            self,
+            "max_host_bytes",
+            _validate_optional_positive_limit(
+                self.max_host_bytes,
+                "GovernorPolicy.max_host_bytes",
+            ),
+        )
+        object.__setattr__(
+            self,
+            "min_device_bytes",
+            _validate_optional_positive_limit(
+                self.min_device_bytes,
+                "GovernorPolicy.min_device_bytes",
+            ),
+        )
+        object.__setattr__(
+            self,
+            "max_device_bytes",
+            _validate_optional_positive_limit(
+                self.max_device_bytes,
+                "GovernorPolicy.max_device_bytes",
+            ),
+        )
+        _check_bounds(self.min_items, self.max_items, "GovernorPolicy.items")
+        _check_bounds(self.min_host_bytes, self.max_host_bytes, "GovernorPolicy.host_bytes")
+        _check_bounds(self.min_device_bytes, self.max_device_bytes, "GovernorPolicy.device_bytes")
+
+
+@dataclass(frozen=True, slots=True)
+class GovernorDecision:
+    """A single budget decision derived from observed StepResult objects."""
+
+    previous_budget: BatchBudget
+    next_budget: BatchBudget
+    reason: str
+    statuses: tuple[StepStatus, ...]
+    consecutive_successes: int
+    consecutive_ooms: int
+    peak_cpu_rss_bytes: int | None = None
+    peak_cuda_allocated_bytes: int | None = None
+    peak_cuda_reserved_bytes: int | None = None
+    peak_cuda_max_allocated_bytes: int | None = None
+    peak_cuda_max_reserved_bytes: int | None = None
+
+
+@dataclass(frozen=True, slots=True)
+class RuntimeGovernorState:
+    """Immutable conservative governor state."""
+
+    current_budget: BatchBudget
+    consecutive_successes: int = 0
+    consecutive_ooms: int = 0
+    last_decision: GovernorDecision | None = None
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.current_budget, BatchBudget):
+            raise TypeError("RuntimeGovernorState.current_budget must be a BatchBudget.")
+        _validate_governed_budget(self.current_budget, "RuntimeGovernorState.current_budget")
+        if not isinstance(self.consecutive_successes, int) or isinstance(
+            self.consecutive_successes,
+            bool,
+        ):
+            raise TypeError("RuntimeGovernorState.consecutive_successes must be an integer.")
+        if self.consecutive_successes < 0:
+            raise ValueError("RuntimeGovernorState.consecutive_successes must be non-negative.")
+        if not isinstance(self.consecutive_ooms, int) or isinstance(self.consecutive_ooms, bool):
+            raise TypeError("RuntimeGovernorState.consecutive_ooms must be an integer.")
+        if self.consecutive_ooms < 0:
+            raise ValueError("RuntimeGovernorState.consecutive_ooms must be non-negative.")
+        if self.last_decision is not None and not isinstance(self.last_decision, GovernorDecision):
+            raise TypeError("RuntimeGovernorState.last_decision must be a GovernorDecision or None.")
+
+
+class ConservativeRuntimeGovernor:
+    """Observe StepResult streams and conservatively adjust future BatchBudget values."""
+
+    def __init__(
+        self,
+        budget: BatchBudget | None = None,
+        *,
+        policy: GovernorPolicy | None = None,
+        state: RuntimeGovernorState | None = None,
+    ) -> None:
+        if budget is None and state is None:
+            raise ValueError("ConservativeRuntimeGovernor requires budget or state.")
+        if budget is not None and state is not None:
+            raise ValueError("ConservativeRuntimeGovernor accepts budget or state, not both.")
+        if budget is not None and not isinstance(budget, BatchBudget):
+            raise TypeError("ConservativeRuntimeGovernor.budget must be a BatchBudget or None.")
+        if budget is not None:
+            _validate_governed_budget(budget, "ConservativeRuntimeGovernor.budget")
+        if policy is not None and not isinstance(policy, GovernorPolicy):
+            raise TypeError("ConservativeRuntimeGovernor.policy must be a GovernorPolicy or None.")
+        if state is not None and not isinstance(state, RuntimeGovernorState):
+            raise TypeError(
+                "ConservativeRuntimeGovernor.state must be a RuntimeGovernorState or None."
+            )
+        self.policy = policy or GovernorPolicy()
+        self.state = state or RuntimeGovernorState(current_budget=budget)  # type: ignore[arg-type]
+
+    @property
+    def current_budget(self) -> BatchBudget:
+        return self.state.current_budget
+
+    def observe_results(self, results: Iterable[StepResult]) -> GovernorDecision:
+        if isinstance(results, StepResult):
+            raise TypeError(
+                "ConservativeRuntimeGovernor.observe_results expects an iterable of StepResult."
+            )
+        if not isinstance(results, Iterable):
+            raise TypeError(
+                "ConservativeRuntimeGovernor.observe_results expects an iterable of StepResult."
+            )
+
+        result_tuple = tuple(results)
+        for result in result_tuple:
+            if not isinstance(result, StepResult):
+                raise TypeError(
+                    "ConservativeRuntimeGovernor.observe_results source must yield StepResult."
+                )
+
+        decision = self._decide(result_tuple)
+        self.state = replace(
+            self.state,
+            current_budget=decision.next_budget,
+            consecutive_successes=decision.consecutive_successes,
+            consecutive_ooms=decision.consecutive_ooms,
+            last_decision=decision,
+        )
+        return decision
+
+    def _decide(self, results: tuple[StepResult, ...]) -> GovernorDecision:
+        previous_budget = self.current_budget
+        statuses = tuple(result.status for result in results)
+        peaks = _resource_peaks(results)
+
+        if not results:
+            reason = _with_resource_suffix("no_results: budget unchanged", peaks)
+            return GovernorDecision(
+                previous_budget=previous_budget,
+                next_budget=previous_budget,
+                reason=reason,
+                statuses=statuses,
+                consecutive_successes=self.state.consecutive_successes,
+                consecutive_ooms=self.state.consecutive_ooms,
+                **peaks,
+            )
+
+        if any(status is StepStatus.OOM_FAULT for status in statuses):
+            next_ooms = self.state.consecutive_ooms + 1
+            next_budget = self._shrink_budget(previous_budget)
+            reason = _with_resource_suffix("oom_fault: shrink budget", peaks)
+            return GovernorDecision(
+                previous_budget=previous_budget,
+                next_budget=next_budget,
+                reason=reason,
+                statuses=statuses,
+                consecutive_successes=0,
+                consecutive_ooms=next_ooms,
+                **peaks,
+            )
+
+        if all(status is StepStatus.SUCCESS for status in statuses):
+            successes = self.state.consecutive_successes + 1
+            if successes >= self.policy.grow_after_successes:
+                next_budget = self._grow_budget(previous_budget)
+                next_successes = 0
+                reason = _with_resource_suffix(
+                    f"success_streak:{successes}: grow budget",
+                    peaks,
+                )
+            else:
+                next_budget = previous_budget
+                next_successes = successes
+                reason = _with_resource_suffix(
+                    f"success_streak:{successes}/{self.policy.grow_after_successes}: budget unchanged",
+                    peaks,
+                )
+            return GovernorDecision(
+                previous_budget=previous_budget,
+                next_budget=next_budget,
+                reason=reason,
+                statuses=statuses,
+                consecutive_successes=next_successes,
+                consecutive_ooms=0,
+                **peaks,
+            )
+
+        reason = _with_resource_suffix("non_oom_fault: budget unchanged", peaks)
+        return GovernorDecision(
+            previous_budget=previous_budget,
+            next_budget=previous_budget,
+            reason=reason,
+            statuses=statuses,
+            consecutive_successes=0,
+            consecutive_ooms=0,
+            **peaks,
+        )
+
+    def _shrink_budget(self, budget: BatchBudget) -> BatchBudget:
+        return BatchBudget(
+            max_host_bytes=_shrink_limit(
+                budget.max_host_bytes,
+                factor=self.policy.shrink_factor,
+                lower=self.policy.min_host_bytes,
+            ),
+            max_device_bytes=_shrink_limit(
+                budget.max_device_bytes,
+                factor=self.policy.shrink_factor,
+                lower=self.policy.min_device_bytes,
+            ),
+            max_items=_shrink_limit(
+                budget.max_items,
+                factor=self.policy.shrink_factor,
+                lower=self.policy.min_items,
+            ),
+        )
+
+    def _grow_budget(self, budget: BatchBudget) -> BatchBudget:
+        return BatchBudget(
+            max_host_bytes=_grow_limit(
+                budget.max_host_bytes,
+                factor=self.policy.grow_factor,
+                upper=self.policy.max_host_bytes,
+            ),
+            max_device_bytes=_grow_limit(
+                budget.max_device_bytes,
+                factor=self.policy.grow_factor,
+                upper=self.policy.max_device_bytes,
+            ),
+            max_items=_grow_limit(
+                budget.max_items,
+                factor=self.policy.grow_factor,
+                upper=self.policy.max_items,
+            ),
+        )
+
+
+def _shrink_limit(value: int | None, *, factor: float, lower: int | None) -> int | None:
+    if value is None:
+        return None
+    floor = 1 if lower is None else lower
+    return max(floor, math.floor(value * factor))
+
+
+def _grow_limit(value: int | None, *, factor: float, upper: int | None) -> int | None:
+    if value is None:
+        return None
+    grown = math.ceil(value * factor)
+    if upper is not None:
+        grown = min(grown, upper)
+    return grown
+
+
+def _resource_peaks(results: tuple[StepResult, ...]) -> dict[str, int | None]:
+    samples: list[ResourceSample] = []
+    for result in results:
+        samples.extend(result.resource_samples)
+    return {
+        "peak_cpu_rss_bytes": _max_optional(sample.cpu_rss_bytes for sample in samples),
+        "peak_cuda_allocated_bytes": _max_optional(
+            sample.cuda_allocated_bytes for sample in samples
+        ),
+        "peak_cuda_reserved_bytes": _max_optional(sample.cuda_reserved_bytes for sample in samples),
+        "peak_cuda_max_allocated_bytes": _max_optional(
+            sample.cuda_max_allocated_bytes for sample in samples
+        ),
+        "peak_cuda_max_reserved_bytes": _max_optional(
+            sample.cuda_max_reserved_bytes for sample in samples
+        ),
+    }
+
+
+def _max_optional(values: Iterable[int | None]) -> int | None:
+    present = [value for value in values if value is not None]
+    if not present:
+        return None
+    return max(present)
+
+
+def _with_resource_suffix(reason: str, peaks: dict[str, int | None]) -> str:
+    details = [f"{key}={value}" for key, value in peaks.items() if value is not None]
+    if not details:
+        return reason
+    return f"{reason}; " + ", ".join(details)
