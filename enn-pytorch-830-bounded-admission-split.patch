+            return _assessment(batch.batch_size, max_admissible_items=3)
+        return _result(batch)
+
+    step = SyntheticAdmissionStep(run)
+    original = _batch(10)
+    results = list(
+        RuntimeRetryRunner(
+            step,
+            admission_split_policy=AdmissionSplitPolicy(
+                min_items=2,
+                max_split_parts=4,
+            ),
